{
  "name": "APEX DRIFT — Seeded Drift Park",
  "short_name": "Apex Drift",
  "description": "A mobile-first seeded drift game: procedurally generated drift parks, handbrake physics, drift-zone combo scoring and a full offline install.",
  "id": "apex-drift",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "landscape",
  "orientation_override": ["landscape", "landscape-primary", "landscape-secondary"],
  "background_color": "#0b0f14",
  "theme_color": "#0b0f14",
  "categories": ["games", "entertainment"],
  "screenshots": [],
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
